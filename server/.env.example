# 服务端环境变量
PORT=3000

# Supabase PostgreSQL 连接串（PGBouncer 池模式）
# 在 Supabase 控制台 → Project Settings → Database → Connection string 获取
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# JWT 配置
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=*
