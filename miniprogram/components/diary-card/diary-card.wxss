/* components/diary-card/diary-card.wxss */
.card {
  display: flex;
  align-items: stretch;
  background: var(--surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
  padding: 28rpx 28rpx 28rpx 0;
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--border-soft);
}
.bar {
  width: 6rpx;
  background: var(--accent);
  margin-right: 28rpx;
  border-radius: 0 6rpx 6rpx 0;
  flex-shrink: 0;
}
.date {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  flex-shrink: 0;
  padding: 0 8rpx;
  border-right: 1rpx dashed var(--border);
  margin-right: 24rpx;
}
.day {
  font-size: 52rpx;
  line-height: 1;
  color: var(--ink);
  font-weight: 700;
}
.month {
  font-size: 22rpx;
  color: var(--accent);
  letter-spacing: 2rpx;
  margin-top: 8rpx;
  font-weight: 600;
}
.week {
  font-size: 20rpx;
  color: var(--ink-faint);
  margin-top: 6rpx;
}
.body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.content {
  font-size: 28rpx;
  color: var(--ink-soft);
  line-height: 1.6;
  word-break: break-all;
}
.meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  flex-wrap: wrap;
}
.mood {
  font-size: 32rpx;
  margin-right: 16rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.tag {
  font-size: 20rpx;
  color: var(--accent);
  padding: 4rpx 14rpx;
  border: 1rpx solid var(--accent);
  border-radius: 20rpx;
  opacity: 0.85;
}
.del {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--bg-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.5;
}
.del-icon {
  font-size: 28rpx;
  color: var(--ink-muted);
  line-height: 1;
}
.del:active { opacity: 1; }
