/* app.wxss — 全局样式 + 主题变量（纸张墨韵方向） */

/* ===== 浅色主题变量 ===== */
.theme-light {
  --bg: #F5F1EA;
  --bg-deep: #EDE7DB;
  --surface: #FFFFFF;
  --surface-soft: #FBF9F4;
  --ink: #1C1917;
  --ink-soft: #44403C;
  --ink-muted: #78716C;
  --ink-faint: #A8A29E;
  --accent: #B45309;
  --accent-soft: #FEF3C7;
  --accent-glow: #FDE68A;
  --sage: #4D7C5F;
  --rose: #BE5A48;
  --border: #E7E2D9;
  --border-soft: #F0EBE0;
  --shadow-sm: 0 2rpx 6rpx rgba(28,25,23,0.04);
  --shadow-md: 0 8rpx 24rpx rgba(28,25,23,0.06);
  --shadow-lg: 0 24rpx 64rpx rgba(28,25,23,0.10);
  --radius-sm: 16rpx;
  --radius-md: 28rpx;
  --radius-lg: 40rpx;
}

/* ===== 深色主题变量 ===== */
.theme-dark {
  --bg: #1F1B16;
  --bg-deep: #18140F;
  --surface: #2A2520;
  --surface-soft: #241F1A;
  --ink: #F5F1EA;
  --ink-soft: #D6D0C4;
  --ink-muted: #A8A29E;
  --ink-faint: #78716C;
  --accent: #F59E0B;
  --accent-soft: #4A3A1A;
  --accent-glow: #785118;
  --sage: #6BA17D;
  --rose: #D17A66;
  --border: #3A332C;
  --border-soft: #2E2823;
  --shadow-sm: 0 2rpx 6rpx rgba(0,0,0,0.30);
  --shadow-md: 0 8rpx 24rpx rgba(0,0,0,0.40);
  --shadow-lg: 0 24rpx 64rpx rgba(0,0,0,0.55);
  --radius-sm: 16rpx;
  --radius-md: 28rpx;
  --radius-lg: 40rpx;
}

/* ===== 基础重置 ===== */
page {
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  transition: background 0.3s ease, color 0.3s ease;
}

view, text, input, textarea, scroll-view { box-sizing: border-box; }

/* 通用容器 */
.container {
  min-height: 100vh;
  background: var(--bg);
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 衬线标题字体 */
.serif {
  font-family: "Songti SC", "STSong", "Source Han Serif SC", Georgia, serif;
  font-weight: 600;
}

/* 文本省略 */
.ellipsis-1 {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 安全区域底部留白 */
.safe-bottom { padding-bottom: calc(env(safe-area-inset-bottom) + 180rpx); }
